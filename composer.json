{
    "name": "omnipulse/tripadvisor",
    "type": "library",
    "description": "Omnipulse's Tripadvisor: a location's rating, bubbles and up to five reviews through Tripadvisor's Content API, the link to write one; its display requirements declared - logo, bubbles from Tripadvisor's addresses, pages kept out of search engines.",
    "keywords": [
        "reviews",
        "tripadvisor",
        "content-api",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-tripadvisor",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnipulse": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "replace": {
        "omnireview/tripadvisor": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\Tripadvisor\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\Tripadvisor\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
